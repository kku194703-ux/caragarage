/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        "Noto Sans JP",
        "Hiragino Kaku Gothic ProN",
        "Yu Gothic",
        sans-serif;
    color: #222;
    background: #fff;
    line-height: 1.8;
}

img {
    display: block;
    width: 100%;
}

a {
    color: inherit;
    text-decoration: none;
}

ul {
    list-style: none;
}


/* =========================
   HEADER
========================= */

header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(255,255,255,0.95);
    border-bottom: 1px solid #ddd;
}

.header-inner {
    max-width: 1200px;
    margin: 0 auto;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
}

.logo {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

nav ul {garage
    display: flex;
    gap: 35px;
}

nav a {
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s;
}

nav a:hover {
    opacity: 0.5;
}


/* =========================
   HERO
========================= */

.hero {
    position: relative;
    min-height: 100svh;
    padding-top: 80px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.38);
    z-index: 1;
}

.hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
}

.hero-content
{
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 120px 30px 80px;
}

.hero h1 {
    font-size: clamp(32px, 4.5vw, 68px);
    line-height: 1.35;
    letter-spacing: 0.06em;
    font-weight: 700;
}

.hero p {
    margin-top: 30px;
    font-size: 18px;
    letter-spacing: 0.12em;
}


/* =========================
   COMMON
========================= */

.section {
    padding: 110px 30px;
}

.inner {
    max-width: 1200px;
    margin: 0 auto;
}

.section-title {
    margin-bottom: 60px;
}

.section-title span {
    display: block;
    font-size: 13px;
    letter-spacing: 0.2em;
    color: #888;
    margin-bottom: 10px;
}

.section-title h2 {
    font-size: 38px;
    letter-spacing: 0.08em;
    line-height: 1.4;
}


/* =========================
   CATEGORY
========================= */

.category {
    background: #f5f5f5;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.category-card {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    color: #fff;
}

.category-card img {
    height: 100%;
    min-height: 300px;
    object-fit: cover;
    transition: transform 0.5s;
}

.category-card:hover img {
    transform: scale(1.05);
}

.category-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.7),
        rgba(0,0,0,0.05)
    );
}

.category-card-content {
    position: absolute;
    z-index: 2;
    left: 25px;
    bottom: 25px;
}

.category-card h3 {
    font-size: 25px;
    letter-spacing: 0.08em;
}

.category-card p {
    margin-top: 5px;
    font-size: 13px;
}


/* =========================
   FEATURE
========================= */

.feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.feature-card {
    padding: 45px;
    background: #f7f7f7;
    border: 1px solid #e5e5e5;
}

.feature-number {
    font-size: 14px;
    letter-spacing: 0.15em;
    color: #888;
}

.feature-card h3 {
    margin-top: 15px;
    font-size: 25px;
}

.feature-card p {
    margin-top: 15px;
    font-size: 15px;
    color: #555;
}


/* =========================
   CONCEPT
========================= */

.concept {
    background: #111;
    color: #fff;
}

.concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.concept-image img {
    height: 550px;
    object-fit: cover;
}

.concept-text h2 {
    font-size: 42px;
    line-height: 1.5;
    letter-spacing: 0.08em;
}

.concept-text p {
    margin-top: 30px;
    color: #ccc;
    font-size: 16px;
}


/* =========================
   USE CASE 非表示
========================= */

section.use-case {
    display: none !important;
}
.use-case {
    background: #f5f5f5;
}

.use-case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.use-case-card {
    background: #fff;
    overflow: hidden;
}

.use-case-card img {
    height: 300px;
    object-fit: cover;
}

.use-case-content {
    padding: 30px;
}

.use-case-content h3 {
    font-size: 24px;
}

.use-case-content p {
    margin-top: 12px;
    color: #555;
}


/* =========================
   FLOW
========================= */

.flow-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.flow-item {
    position: relative;
    padding: 35px 25px;
    border: 1px solid #ddd;
}

.flow-number {
    font-size: 13px;
    color: #888;
    letter-spacing: 0.15em;
}

.flow-item h3 {
    margin-top: 12px;
    font-size: 20px;
}

.flow-item p {
    margin-top: 10px;
    font-size: 14px;
    color: #555;
}


/* =========================
   WORKS
========================= */

.works {
    background: #f5f5f5;
}

.works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.works-card {
    background: #fff;
    overflow: hidden;
}

.works-card img {
    height: 320px;
    object-fit: cover;
}

.works-content {
    padding: 25px;
}

.works-content h3 {
    font-size: 22px;
}

.works-content p {
    margin-top: 10px;
    color: #555;
}


/* =========================
   CONTACT
========================= */

.contact {
    position: relative;
    color: #fff;
    overflow: hidden;
}

.contact::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
}

.contact img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.contact-inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 120px 30px;
}

.contact h2 {
    font-size: 45px;
    letter-spacing: 0.08em;
}

.contact p {
    margin-top: 20px;
    font-size: 16px;
}

.contact-button {
    display: inline-block;
    margin-top: 40px;
    padding: 18px 60px;
    background: #fff;
    color: #111;
    font-weight: 700;
    transition: 0.3s;
}

.contact-button:hover {
    background: #ddd;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #111;
    color: #fff;
    padding: 50px 30px;
}

.footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 30px;
}

.footer-logo {
    font-size: 22px;
    font-weight: 700;
}

.footer-info {
    font-size: 13px;
    color: #aaa;
}

.copyright {
    margin-top: 35px;
    padding-top: 25px;
    border-top: 1px solid #333;
    text-align: center;
    font-size: 12px;
    color: #777;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

    nav ul {
        gap: 15px;
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .concept-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .concept-image img {
        height: 450px;
    }

    .flow-list {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    .header-inner {
        height: 65px;
        padding: 0 20px;
    }

    .logo {
        font-size: 17px;
    }

    nav ul {
        gap: 10px;
    }

    nav a {
        font-size: 11px;
    }

    .header-inner {
        height: 65px;
        gap: 16px;
    }

    nav ul {
        gap: 10px;
    }

    nav a {
        font-size: 10px;
    }

    .hero {
        padding-top: 65px;
        min-height: 100svh;
    }

    .hero img {
        object-position: 58% center;
    }

    .hero-content {
        padding: 100px 20px 60px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 13px;
    }

    .section {
        padding: 75px 20px;
    }

    .section-title {
        margin-bottom: 35px;
    }

    .section-title h2 {
        font-size: 29px;
    }

    .category-grid,
    .feature-grid,
    .use-case-grid,
    .works-grid,
    .flow-list {
        grid-template-columns: 1fr;
    }

    .category-card {
        min-height: 230px;
    }

    .category-card img {
        min-height: 230px;
    }

    .feature-card {
        padding: 30px;
    }

    .concept-image img {
        height: 300px;
    }

    .concept-text h2 {
        font-size: 30px;
    }

    .use-case-card img,
    .works-card img {
        height: 240px;
    }

    .contact-inner {
        padding: 80px 20px;
    }

    .contact h2 {
        font-size: 32px;
    }

    .contact-button {
        padding: 15px 40px;
    }

    .footer-inner {
        flex-direction: column;
    }

}
